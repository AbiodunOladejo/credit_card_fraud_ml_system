# ── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit actual credentials.
#
# Usage:
#   cp .env.example .env
#   nano .env   ← add your real values

# ── MySQL connection string ───────────────────────────────────────────────────
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# Render managed MySQL example:
#   DATABASE_URL=mysql+pymysql://fraud_user:yourpassword@oregon-mysql.render.com:3306/fraud_db
# Local MySQL example:
#   DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/fraud_db
#
# If DATABASE_URL is not set, the API will run without database persistence.
# The Streamlit dashboard will show demo data instead of live predictions.
DATABASE_URL=

# ── FastAPI base URL for Streamlit dashboard ──────────────────────────────────
# Local development:
#   API_URL=http://localhost:8000
# Deployed on Render:
#   API_URL=https://your-fraud-api.onrender.com
API_URL=http://localhost:8000
